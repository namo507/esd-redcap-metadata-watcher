# Copy to `.env` and fill in real values. `.env` is git-ignored; keep it that way.
#
# Every token here must be a READ-ONLY REDCap API token. The dashboard and the
# recruitment generator only ever call export methods, but the token itself is
# the real boundary — issue tokens with export rights only.

REDCAP_API_URL=https://redcap.research.sc.edu/api/

NANO_API_TOKEN=
NICO_API_TOKEN=
IPSA_API_TOKEN=
ACTION_API_TOKEN=

# Optional tuning (defaults shown)
# REDCAP_MIN_REQUEST_INTERVAL_SECONDS=1.25
# REDCAP_REFRESH_INTERVAL_SECONDS=1800
# REDCAP_RATE_LIMIT_RETRY_SECONDS=15
# REDCAP_REQUEST_TIMEOUT_SECONDS=180
