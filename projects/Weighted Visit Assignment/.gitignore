__pycache__/
*.py[cod]
# Everything generated lives under data/. The inbox is the one exception: the
# folder has to exist on a fresh clone, and its README explains what to drop
# there. Its contents stay ignored -- they are real calendars.
data/*
!data/inbox/
data/inbox/*
!data/inbox/README.md
logs/
reports/
deck/math/
deck/preview/
deck/math_dims.json

# Calendar credentials. Never commit these.
config/calendar.env
config/calendar-map.json

# Visitboard runtime
data/visitboard*.db*

# Static publish build (regenerate with `make static`)
dist-static/
.netlify/

# Uploaded Outlook calendar prints. These are real calendars: a month export
# carries event titles for every overlaid person. Never commit them.
data/uploads/

# Calendar prints awaiting import. Same reason as data/uploads: real calendars.
data/inbox/*.pdf

# Claude Code session scratch: launch configs and agent worktrees. The
# worktrees are whole checkouts of this repo, so a plain `git add .` on the
# project directory would otherwise commit a copy of it into itself.
.claude/
