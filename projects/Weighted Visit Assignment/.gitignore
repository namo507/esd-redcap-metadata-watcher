__pycache__/
*.py[cod]
# Everything generated lives under data/. The inbox is the one exception: the
# folder has to exist on a fresh clone, and its README explains what to drop
# there. Its contents stay ignored -- they are real calendars.
data/*
!data/inbox/
data/inbox/*
!data/inbox/README.md
logs/
reports/
deck/math/
deck/preview/
deck/math_dims.json

# Calendar credentials. Never commit these.
config/calendar.env
config/calendar-map.json

# Visitboard runtime
data/visitboard*.db*

# Static publish build (regenerate with `make static`)
dist-static/
.netlify/

# Uploaded Outlook calendar prints. These are real calendars: a month export
# carries event titles for every overlaid person. Never commit them.
data/uploads/

# Calendar prints awaiting import. Same reason as data/uploads: real calendars.
data/inbox/*.pdf

# Claude Code session scratch: launch configs and agent worktrees. The
# worktrees are whole checkouts of this repo, so a plain `git add .` on the
# project directory would otherwise commit a copy of it into itself.
.claude/

# Spreadsheets in this project mirror the board: roster, protocol schedule,
# visit queue and history. A queue sheet carries participant IDs and anchor
# dates, which are birth or expected-due dates, and this repository is public
# and serves GitHub Pages from itself. No .xlsx has ever been tracked here, so
# ignoring them keeps a `git add -A` from making one the first.
*.xlsx

# A Power BI theme that appeared in config/. Nothing here reads it, and it is
# not the ESD palette. Ignored because a plain `git add -A` kept sweeping it
# into commits it did not belong in. Delete this line if you want it tracked.
config/PowerBI-Theme-ESD.json

# A project-local interpreter with every requirement installed. Built with
# `python3.12 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt`,
# matched to the version CI runs rather than whatever python3 happens to be.
.venv/

# A throwaway copy of config/ for demos. The board writes here instead of
# the lab's real numbers. Rebuilt by `make serve-scratch`.
config-scratch/

# REDCap API token. A credential for a study with participant data: it
# belongs in this file on one machine and nowhere in git.
config/redcap.env
config/*.env
data/redcap/
